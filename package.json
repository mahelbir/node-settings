{
  "name": "@mahelbir/settings",
  "version": "6.0.0",
  "private": false,
  "description": "Lightweight settings manager with deep get/set, pluggable stores, schema validation and auto-refresh.",
  "keywords": [
    "settings",
    "config",
    "json config",
    "config file",
    "standard schema"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahelbir/node-settings.git"
  },
  "license": "MIT",
  "author": "Mahmuthan Elbir",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/**/*",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "node --test",
    "typecheck": "tsc",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "relock": "rm -rf node_modules package-lock.json && NODE_ENV= npm install --include=dev --include=optional"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "es-toolkit": "^1.53.1",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/proper-lockfile": "^4.1.4",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
